{
  "name": "chizu-no-gyokan-map-exploration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run tests/domain.test.ts tests/notes.test.ts tests/perspectives.test.ts tests/relations.test.ts tests/discoveries.test.ts",
    "test:privacy": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:geometry": "python3 scripts/check-geometry.py",
    "test:e2e": "playwright test",
    "verify": "node scripts/verify.mjs",
    "privacy": "sh scripts/check-email-privacy.sh",
    "prepare": "node scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/geojson": "7946.0.16",
    "@types/leaflet": "1.9.21",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
